{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Customer orders with customization data"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "stripeSessionId": {
      "type": "string",
      "unique": true
    },
    "customerEmail": {
      "type": "email"
    },
    "customerName": {
      "type": "string"
    },
    "totalAmount": {
      "type": "integer",
      "min": 0
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "paid", "processing", "shipped", "delivered", "cancelled", "expired", "failed"],
      "default": "pending"
    },
    "items": {
      "type": "json"
    },
    "orderSummary": {
      "type": "string"
    },
    "shippingAddress": {
      "type": "json"
    },
    "productionNotes": {
      "type": "richtext"
    },
    "productionData": {
      "type": "json"
    },
    "promoCode": {
      "type": "string"
    },
    "discountAmount": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "trackingNumber": {
      "type": "string"
    },
    "trackingCarrier": {
      "type": "string"
    },
    "productionToken": {
      "type": "string",
      "private": true
    }
  }
}
